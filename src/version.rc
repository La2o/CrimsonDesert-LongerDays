// File properties for the .asi (right-click > Properties > Details).
// Proper version metadata also makes antivirus heuristics less likely to
// flag an unsigned DLL downloaded from a mod site.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     LONGERDAYS_VERSION_MAJOR, LONGERDAYS_VERSION_MINOR, LONGERDAYS_VERSION_PATCH, 0
PRODUCTVERSION  LONGERDAYS_VERSION_MAJOR, LONGERDAYS_VERSION_MINOR, LONGERDAYS_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CrimsonDesert-LongerDays contributors"
            VALUE "FileDescription",  "Longer Days - day/night length mod for Crimson Desert (ASI plugin)"
            VALUE "FileVersion",      LONGERDAYS_VERSION
            VALUE "InternalName",     "CrimsonDesertLongerDays"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "CrimsonDesertLongerDays.asi"
            VALUE "ProductName",      "Crimson Desert - Longer Days"
            VALUE "ProductVersion",   LONGERDAYS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
